# BingWallpaper 后端配置示例
#
# 用法：复制成 .env（该文件已被 .gitignore 忽略）。
# 优先级：真实环境变量 > 本文件 > 代码默认值。
# 也就是说容器 / CI 里注入的环境变量会覆盖这里，符合通行约定。

# ---- 运行环境 ----
# development | production
# production 会同时影响三件事：CORS 收紧、trust proxy 默认信任 1 层反代、docs 缓存
APP_ENV=development

# 是否输出调试日志（缓存命中、抓取条数等）。默认：非生产即为开
APP_DEBUG=1

# ---- 服务 ----
# PHP 内置服务器（tools/serve.php）读取的监听地址与端口
# 默认只绑本机。要让同网络访问或放在反代后面，改成 0.0.0.0
HOST=127.0.0.1
PORT=2665

# sitemap.xml / robots.txt 里使用的站点根地址（不带结尾斜杠）
SITE_ORIGIN=https://bing.hecady.com

# ---- 壁纸库（历史归档数据集）----
# bingimages 数据集所在目录。留空则默认取项目根下的 bingimages/。
# 数据集由 bingimages/ 目录独立产出，**不要**复制进本项目，否则会有两份并必然漂移。
# 支持绝对路径，也支持相对项目根的路径。
#
# 注意「只读」指的是 **Web 后端的读取路径**：它连接后立刻 PRAGMA query_only = 1。
# 真正会写这个库的是 app/ArchiveUpdater.php，由两条路径触发：每天首次访问（异步、
# 不影响访客等待）或计划任务（tools/update-archive.php，每天 08:00，可选兜底）。
# 它只 INSERT，不 UPDATE / DELETE。详见 DEPLOY.md 第 7 节。
# BINGIMAGES_DIR=bingimages

# 壁纸库里的图片域名。**必须是 cn.bing.com** —— Bing 只在这个域名下提供 4K 版本，
# app/Archive.php 的 upgradeableTo4k() 也只认它；改成 www.bing.com 会让新补的行
# url_4k 全变 null、4K 按钮失效（更新脚本检测到会拒绝写库）。
# 与 /api/bing/today 用的 bingImageBase()（www.bing.com）是两回事，别混用。
# ARCHIVE_IMAGE_BASE=https://cn.bing.com

# Bing 首页归档接口。一般不用改；指向不可达地址可用来验证「抓取失败」这条分支。
# BING_API_URL=https://www.bing.com/HPImageArchive.aspx

# 壁纸库每页条数（默认 24，上限固定 100）
# ARCHIVE_PAGE_SIZE=24

# 「每天首次访问自动更新壁纸库」开关（默认开）。
# 开：每天第一个访客到来时，在响应发出去之后（不影响他的等待）自动补一次当日新壁纸，
#     不依赖计划任务；与计划任务共用锁与当日标记，谁先跑成另一个当天就不必再跑。
# 关：只保留计划任务兜底（没配 cron 的站点会停止更新）。
# 之所以留这个开关，是因为它是本站唯一「访客会间接触发出站请求」的功能，
# 线上要能只改 .env 关掉它（改完无需重启 PHP），而不必去动 public/index.php。
# ARCHIVE_AUTO_UPDATE=1

# ---- CORS ----
# 逗号分隔的允许来源。
# 留空或填 *：
#   开发环境 → 放行全部
#   生产环境 → 不下发任何 CORS 头（浏览器按同源策略限制，这是真正的收紧）
# 注意：不要指望「反射请求方 Origin」来做收紧，那等于放行全网。
# CORS_ORIGIN=https://bing.hecady.com

# ---- 反向代理 ----
# 反向代理层数。生产默认 1（单层 nginx/Caddy）。
# 直连部署（无代理）必须设 0，否则客户端 IP 会被错误解析，限流形同虚设。
# TRUST_PROXY=1

# ---- 缓存 ----
# Bing 数据缓存时长（秒），默认 3600
# BING_CACHE_TTL=3600

# ---- 限流 ----
# 窗口秒数与窗口内允许的请求数，默认 60 / 200
# API_RATE_LIMIT_WINDOW=60
# API_RATE_LIMIT_MAX=200
