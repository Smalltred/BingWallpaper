# EditorConfig — 让不同编辑器/IDE 对同一份代码保持一致的基础格式
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown 里行尾两个空格是「软换行」语法，不能裁掉
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[Makefile]
indent_style = tab
